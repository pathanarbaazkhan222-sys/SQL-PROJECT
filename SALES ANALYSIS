-- SQL SALES ANALYSIS PROJECT

-- 1. Display all records
SELECT *
FROM SALES_TRANSACTIONS;


-- 2. Display selected columns
SELECT PRODUCT_NAME, QUANTITY, CITY, PAYMENT_MODE
FROM SALES_TRANSACTIONS;


-- 3. Find transactions from Mumbai
SELECT *
FROM SALES_TRANSACTIONS
WHERE CITY = 'Mumbai';


-- 4. Find online payments
SELECT *
FROM SALES_TRANSACTIONS
WHERE PAYMENT_MODE = 'Online';


-- 5. Find products with unit price greater than 500
SELECT PRODUCT_NAME, UNIT_PRICE
FROM SALES_TRANSACTIONS
WHERE UNIT_PRICE > 500;


-- 6. Find Mumbai transactions with unit price greater than 500
SELECT PRODUCT_NAME, QUANTITY, CITY, UNIT_PRICE
FROM SALES_TRANSACTIONS
WHERE CITY = 'Mumbai'
AND UNIT_PRICE > 500;


-- 7. Find online transactions OR products above 500
SELECT PRODUCT_NAME, QUANTITY, CITY, PAYMENT_MODE, UNIT_PRICE
FROM SALES_TRANSACTIONS
WHERE PAYMENT_MODE = 'Online'
OR UNIT_PRICE > 500;


-- 8. Find Mumbai online transactions
SELECT PRODUCT_NAME, QUANTITY, CITY, PAYMENT_MODE
FROM SALES_TRANSACTIONS
WHERE CITY = 'Mumbai'
AND PAYMENT_MODE = 'Online';


-- 9. Sort products by unit price from highest to lowest
SELECT PRODUCT_NAME, UNIT_PRICE
FROM SALES_TRANSACTIONS
ORDER BY UNIT_PRICE DESC;


-- 10. Sort transactions by city
SELECT PRODUCT_NAME, QUANTITY, CITY, PAYMENT_MODE
FROM SALES_TRANSACTIONS
ORDER BY CITY ASC;
