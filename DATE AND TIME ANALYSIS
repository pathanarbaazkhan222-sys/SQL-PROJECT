-- DATE AND TIME ANALYSIS
-- Display transaction date
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE
FROM SALES_TRANSACTIONS;


-- Extract year from transaction date
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE,
    YEAR(TRANSACTION_DATE) AS TRANSACTION_YEAR
FROM SALES_TRANSACTIONS;


-- Extract month number
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE,
    MONTH(TRANSACTION_DATE) AS MONTH_NUMBER
FROM SALES_TRANSACTIONS;


-- Extract month name
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE,
    MONTHNAME(TRANSACTION_DATE) AS MONTH_NAME
FROM SALES_TRANSACTIONS;


-- Extract day from transaction date
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE,
    DAY(TRANSACTION_DATE) AS TRANSACTION_DAY
FROM SALES_TRANSACTIONS;


-- Extract day name
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE,
    DAYNAME(TRANSACTION_DATE) AS DAY_NAME
FROM SALES_TRANSACTIONS;


-- Extract quarter
SELECT
    PRODUCT_NAME,
    TRANSACTION_DATE,
    QUARTER(TRANSACTION_DATE) AS QUARTER_NUMBER
FROM SALES_TRANSACTIONS;


-- Calculate total sales by year
SELECT
    YEAR(TRANSACTION_DATE) AS TRANSACTION_YEAR,
    SUM(QUANTITY * UNIT_PRICE) AS TOTAL_SALES
FROM SALES_TRANSACTIONS
GROUP BY YEAR(TRANSACTION_DATE)
ORDER BY TRANSACTION_YEAR;


-- Calculate total sales by month
SELECT
    MONTH(TRANSACTION_DATE) AS MONTH_NUMBER,
    MONTHNAME(TRANSACTION_DATE) AS MONTH_NAME,
    SUM(QUANTITY * UNIT_PRICE) AS TOTAL_SALES
FROM SALES_TRANSACTIONS
GROUP BY
    MONTH(TRANSACTION_DATE),
    MONTHNAME(TRANSACTION_DATE)
ORDER BY MONTH_NUMBER;


-- Calculate total quantity by month
SELECT
    MONTHNAME(TRANSACTION_DATE) AS MONTH_NAME,
    SUM(QUANTITY) AS TOTAL_QUANTITY
FROM SALES_TRANSACTIONS
GROUP BY
    MONTH(TRANSACTION_DATE),
    MONTHNAME(TRANSACTION_DATE)
ORDER BY MONTH(TRANSACTION_DATE);


-- Calculate sales by quarter
SELECT
    QUARTER(TRANSACTION_DATE) AS QUARTER_NUMBER,
    SUM(QUANTITY * UNIT_PRICE) AS TOTAL_SALES
FROM SALES_TRANSACTIONS
GROUP BY QUARTER(TRANSACTION_DATE)
ORDER BY QUARTER_NUMBER;


-- Find sales by day of week
SELECT
    DAYNAME(TRANSACTION_DATE) AS DAY_NAME,
    SUM(QUANTITY * UNIT_PRICE) AS TOTAL_SALES
FROM SALES_TRANSACTIONS
GROUP BY DAYNAME(TRANSACTION_DATE)
ORDER BY TOTAL_SALES DESC;


-- Find the highest sales transaction date
SELECT
    TRANSACTION_DATE,
    PRODUCT_NAME,
    QUANTITY,
    UNIT_PRICE,
    QUANTITY * UNIT_PRICE AS TOTAL_AMOUNT
FROM SALES_TRANSACTIONS
ORDER BY TOTAL_AMOUNT DESC
LIMIT 1;
